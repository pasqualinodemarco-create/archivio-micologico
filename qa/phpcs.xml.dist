<?xml version="1.0"?>
<ruleset name="Archivio Micologico QA">
	<description>Sicurezza WordPress e compatibilità PHP 8.0+.</description>
	<file>../archivio-micologico.php</file>
	<file>../autoload.php</file>
	<file>../uninstall.php</file>
	<file>../src</file>
	<file>../templates</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Sicurezza: escape dell'output, nonce, input validato e sanificato, SQL preparato. -->
	<rule ref="WordPress.Security">
		<!-- $_GET read only to choose what to display (filters, tabs, notices): no state change. -->
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="archivio-micologico"/></property>
		</properties>
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
	</rule>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="Generic.PHP.ForbiddenFunctions"/>

	<!-- Compatibilità: PHP dichiarato nel plugin (8.0) e successivi. -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
